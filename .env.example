# mlpowermeter environment template.
# Copy to .env and fill in as needed. .env is gitignored and must never be committed.
# None of the core experiments require secrets; every variable here is optional.

# Platform tag used in experiment output paths (e.g. rtx4090-laptop, a100-sxm4-40gb).
# Leave empty to auto-detect from the GPU name.
TOMLML_PLATFORM_TAG=

# NVML target override. Leave empty for automatic resolution of the torch device
# to the physical GPU by UUID. Set to a value like GPU-xxxxxxxx-xxxx-... only if
# automatic resolution fails and the manual mapping has been verified.
TOMLML_NVML_UUID=

# Optional experiment tracking (repo-native LOGBOOK.md and findings.md remain
# the authoritative record; a tracking service is supplementary).
WANDB_API_KEY=
WANDB_MODE=disabled
